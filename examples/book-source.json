{
  "bookSourceUrl": "https://your-site.example",
  "bookSourceName": "示例书源（请替换网址和选择器）",
  "bookSourceGroup": "示例",
  "bookSourceType": 0,
  "enabled": false,
  "searchUrl": "/search?q={{key}}&page={{page}}",
  "ruleSearch": {
    "bookList": ".book",
    "name": "a@text",
    "author": ".author@text",
    "bookUrl": "a@href"
  },
  "ruleBookInfo": {
    "name": "h1@text",
    "intro": ".intro@text",
    "tocUrl": "a.toc@href"
  },
  "ruleToc": {
    "chapterList": ".chapters a",
    "chapterName": "text",
    "chapterUrl": "href"
  },
  "ruleContent": {"content": "#content@text"}
}
